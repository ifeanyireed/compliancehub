# ComplianceHub Database Configuration (Neon PostgreSQL)
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@YOUR_HOST-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Application Ports & URLs
PORT=8080
NEXT_PUBLIC_API_URL=http://localhost:8080

# Cloudinary Storage Configuration
CLOUDINARY_URL=cloudinary://YOUR_API_KEY:YOUR_API_SECRET@YOUR_CLOUD_NAME
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=YOUR_CLOUD_NAME
NEXT_PUBLIC_CLOUDINARY_API_KEY=YOUR_API_KEY

# Authentication Secret
JWT_SECRET=your_jwt_secret_here

# Brevo SMTP Relay Configuration
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_brevo_user
SMTP_PASSWORD=your_brevo_password
SMTP_FROM_EMAIL=hello@compliancehub.ng
SMTP_FROM_NAME=ComplianceHub Nigeria
